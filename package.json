{
  "name": "dsh-box-ui",
  "version": "1.2.0",
  "description": "DeepSeek Harness 插件：设置页里的留言箱——查看条目、改回执、回复、删除与新建。 | DSH plugin: a triage inbox in the settings page — view, acknowledge, reply, remove and create items.",
  "author": "蝠羽科技",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "requirement",
    "message-box",
    "triage",
    "batwing-tech"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuyu-technology/dsh-box-ui.git"
  },
  "homepage": "https://github.com/fuyu-technology/dsh-box-ui#readme",
  "bugs": {
    "url": "https://github.com/fuyu-technology/dsh-box-ui/issues"
  }
}
